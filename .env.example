# Server-only credentials; never prefix these with NEXT_PUBLIC_.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Use http://localhost:3000 for local development.
CONTACT_ORIGIN=https://safenet-developers.com
# Enable only behind a trusted proxy that overwrites X-Real-IP.
CONTACT_TRUST_PROXY=false
# Optional local IP database. Leave empty to use the Ukraine fallback.
ILA_DATA_DIR=
ILA_TMP_DATA_DIR=
ILA_IP_LOCATION_DB=user
ILA_AUTO_UPDATE=false
